# Local .terraform directories
**/.terraform/*
.terraform/
**/.terraform.lock.hcl

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore plan files
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Lambda build artifacts and dependencies
node_modules/
*.zip

# Postman local app workspace
.postman/
postman/

# Environment files
.env
.env.*


