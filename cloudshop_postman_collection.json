{
	"info": {
		"_postman_id": "cloudshop-supernube-v1",
		"name": "CloudShop Enterprise API",
		"description": "Colección completa de pruebas para API Gateway Serverless de CloudShop Enterprise (AWS Lambda + DynamoDB + EventBridge).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://XYZ.execute-api.us-east-1.amazonaws.com/dev",
			"type": "string"
		},
		{
			"key": "adminToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "clientToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "storeId",
			"value": "",
			"type": "string"
		},
		{
			"key": "productId",
			"value": "",
			"type": "string"
		},
		{
			"key": "orderId",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Autenticación (Auth)",
			"item": [
				{
					"name": "1.1 Login Admin (Seed)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('adminToken', jsonData.token);",
									"    console.log('Admin Token guardado en collectionVariables');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@cloudshop.com\",\n  \"password\": \"AdminSecretPassword123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Inicia sesión con la cuenta de administrador sembrada por defecto en Terraform. Guarda automáticamente el token en {{adminToken}}."
					},
					"response": []
				},
				{
					"name": "1.2 Registro Nuevo Cliente",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"Juan Pérez\",\n  \"email\": \"juan.perez@example.com\",\n  \"password\": \"ClientePass123!\",\n  \"rol\": \"CLIENTE\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"register"
							]
						},
						"description": "Registra un usuario con rol CLIENTE en la tabla DynamoDB Users."
					},
					"response": []
				},
				{
					"name": "1.3 Login Cliente",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('clientToken', jsonData.token);",
									"    console.log('Client Token guardado en collectionVariables');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"juan.perez@example.com\",\n  \"password\": \"ClientePass123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Inicia sesión con el cliente registrado. Guarda automáticamente el token en {{clientToken}}."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Tiendas (Stores)",
			"item": [
				{
					"name": "2.1 Crear Tienda (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.storeId) {",
									"    pm.collectionVariables.set('storeId', jsonData.storeId);",
									"    console.log('storeId guardado:', jsonData.storeId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"Tienda Central San Salvador\",\n  \"descripcion\": \"Sucursal principal de tecnología y electrónicos\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/stores",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"stores"
							]
						},
						"description": "Crea una nueva tienda. Requiere rol ADMIN."
					},
					"response": []
				},
				{
					"name": "2.2 Listar Tiendas",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{clientToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/stores",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"stores"
							]
						},
						"description": "Retorna todas las tiendas activas."
					},
					"response": []
				},
				{
					"name": "2.3 Detalle de Tienda por ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{clientToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/stores/{{storeId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"stores",
								"{{storeId}}"
							]
						},
						"description": "Obtiene la información de una tienda específica."
					},
					"response": []
				},
				{
					"name": "2.4 Actualizar Tienda (Admin)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"Tienda Central - Flagship Store\",\n  \"descripcion\": \"Sucursal principal renovada con atención VIP\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/stores/{{storeId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"stores",
								"{{storeId}}"
							]
						},
						"description": "Actualiza el nombre o la descripción de una tienda (Solo Admin)."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Catálogo de Productos (Products)",
			"item": [
				{
					"name": "3.1 Crear Producto (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.productId) {",
									"    pm.collectionVariables.set('productId', jsonData.productId);",
									"    console.log('productId guardado:', jsonData.productId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"codigo\": \"LAP-001\",\n  \"nombre\": \"Laptop CloudBook Pro\",\n  \"descripcion\": \"Laptop de alto rendimiento 16GB RAM 512GB SSD\",\n  \"categoria\": \"Electronica\",\n  \"precio\": 899.99,\n  \"inventario\": 15,\n  \"storeId\": \"{{storeId}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/products",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"products"
							]
						},
						"description": "Crea un producto asociado a una tienda activa. Requiere rol ADMIN."
					},
					"response": []
				},
				{
					"name": "3.2 Listar Productos",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{clientToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/products",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"products"
							]
						},
						"description": "Listado de todos los productos disponibles."
					},
					"response": []
				},
				{
					"name": "3.3 Filtrar Productos por Categoría",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{clientToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/products?categoria=Electronica",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"products"
							],
							"query": [
								{
									"key": "categoria",
									"value": "Electronica"
								}
							]
						},
						"description": "Obtiene productos filtrados por categoría."
					},
					"response": []
				},
				{
					"name": "3.4 Detalle de Producto por ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{clientToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/products/{{productId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"products",
								"{{productId}}"
							]
						},
						"description": "Muestra los detalles completos de un producto."
					},
					"response": []
				},
				{
					"name": "3.5 Actualizar Inventario / Producto",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"precio\": 849.99,\n  \"inventario\": 25\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/products/{{productId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"products",
								"{{productId}}"
							]
						},
						"description": "Actualiza datos o stock del producto (Admin puede editar cualquier campo; Operador sólo inventario)."
					},
					"response": []
				}
			]
		},
		{
			"name": "4. Carrito de Compras (Cart)",
			"item": [
				{
					"name": "4.1 Agregar Producto al Carrito",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{clientToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/cart/items",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"cart",
								"items"
							]
						},
						"description": "Agrega un ítem al carrito de compras del usuario autenticado."
					},
					"response": []
				},
				{
					"name": "4.2 Ver Carrito",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{clientToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/cart",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"cart"
							]
						},
						"description": "Consulta el contenido del carrito del cliente actual."
					},
					"response": []
				},
				{
					"name": "4.3 Modificar Cantidad en Carrito",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{clientToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"quantity\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/cart/items/{{productId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"cart",
								"items",
								"{{productId}}"
							]
						},
						"description": "Modifica la cantidad de un ítem en el carrito."
					},
					"response": []
				}
			]
		},
		{
			"name": "5. Pedidos (Orders & Checkout)",
			"item": [
				{
					"name": "5.1 Crear Pedido (Checkout)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.orderId) {",
									"    pm.collectionVariables.set('orderId', jsonData.orderId);",
									"    console.log('orderId guardado:', jsonData.orderId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{clientToken}}"
							},
							{
								"key": "Idempotency-Key",
								"value": "checkout-prueba-001"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/orders",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"orders"
							]
						},
						"description": "Procesa el Checkout convirtiendo los ítems del carrito en un nuevo pedido estado PENDIENTE. Dispara el evento ORDER_CREATED a EventBridge."
					},
					"response": []
				},
				{
					"name": "5.2 Listar Mis Pedidos",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{clientToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/orders",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"orders"
							]
						},
						"description": "Obtiene la lista de pedidos del usuario autenticado."
					},
					"response": []
				},
				{
					"name": "5.3 Ver Detalle de Pedido",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{clientToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/orders/{{orderId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"orders",
								"{{orderId}}"
							]
						},
						"description": "Consulta un pedido por su orderId."
					},
					"response": []
				},
				{
					"name": "5.4 Actualizar Estado de Pedido (Admin)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"estado\": \"CONFIRMADO\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/orders/{{orderId}}/status",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"orders",
								"{{orderId}}",
								"status"
							]
						},
						"description": "Cambia el estado de un pedido (Estados: PENDIENTE -> CONFIRMADO -> EN_PREPARACION -> ENVIADO -> ENTREGADO)."
					},
					"response": []
				}
			]
		},
		{
			"name": "6. Reportes y Dashboard (Reports)",
			"item": [
				{
					"name": "6.1 Dashboard Ejecutivo (Admin)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/reports/dashboard",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"reports",
								"dashboard"
							]
						},
						"description": "Obtiene las métricas ejecutivas consolidadas (Total ventas, productos más vendidos, stock agotado, clientes principales, etc). Solo Admin."
					},
					"response": []
				}
			]
		}
	]
}
